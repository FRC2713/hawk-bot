# --- Slack app credentials (Basic Information -> App Credentials) ---
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Any long random string; signs the install OAuth state param.
#   openssl rand -hex 32
SLACK_STATE_SECRET=

# Public HTTPS base URL this app is reachable at. Slack posts slash commands
# and events to $PUBLIC_URL/slack/events, redirects install OAuth to
# $PUBLIC_URL/slack/oauth_redirect. It must match the app manifest exactly.
PUBLIC_URL=https://hawk-bot.example.org
PORT=3000

# Where the SQLite database lives. One volume, nothing else is stateful.
DATA_DIR=./data

# 32 bytes, base64. Encrypts the stored workspace installation, which carries
# the bot token.
#   openssl rand -base64 32
# Losing it costs one reinstall by an admin — unlike hawk-mod's key of the same
# name, no per-person data depends on it.
TOKEN_ENCRYPTION_KEY=

TZ=America/New_York

# debug | info | warn | error
LOG_LEVEL=info

# Google Cloud service account with read-only Calendar API access. Create the
# account, download its JSON key, then base64 it into one line:
#   base64 -i service-account.json | tr -d '\n'
# A mentor shares the Team Meeting Calendar with the service account's own
# email address (read-only). The calendar's id is set via `/hawkbot config set
# team_meeting_calendar_id`, not here — see domain/settings.ts.
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# Trusted Hawk Suite proxy, off by default. Enable only on an isolated backend
# network shared with Caddy, with no published backend port.
HAWK_SUITE_TRUST_PROXY=false
HAWK_SUITE_TEAM_ID=
HAWK_SUITE_ISSUER=
